# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: Cloudflare proxy domain for client-side @supabase/supabase-js (src/lib/supabase.ts)
VITE_SUPABASE_URL=https://your-cloudflare-proxy.vigilamc.com
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Production & Auth Redirect Configuration
# Point this to your live production domain (e.g. https://vigilamc.com)
NEXT_PUBLIC_SITE_URL=https://vigilamc.com

# Database (Prisma / Supabase Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Admin / Notifications
ADMIN_NOTIFICATION_EMAIL=admin@vigilamc.com

# Zoho SMTP Email Configuration (Form B Reports, Overdue Digests, Portal Invites & Alerts)
# Swappable to ZeptoMail by changing env values only (zero code change)
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Cloudflare R2 Object Storage
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Apple Push Notification service (APNs HTTP/2 Provider Token Auth for iOS Field App)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.vigilamc
APNS_PRIVATE_KEY=
# Optional: "production" or "sandbox" (leave unset to try production then sandbox automatically)
APNS_ENVIRONMENT=
