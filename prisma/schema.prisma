datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Enquiry {
  id            String   @id @default(cuid())
  type          String   @default("DEMO") // DEMO, CONTACT, QUICK_INQUIRY, NEWSLETTER
  name          String?
  company       String?
  email         String
  phone         String?
  city          String?
  message       String?
  facilityType  String?
  assetCount    String?
  preferredDate String?
  preferredTime String?
  source        String?  @default("Website")
  status        String   @default("NEW") // NEW, CONTACTED, CONVERTED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model InvestorInterest {
  id                   String   @id @default(cuid())
  fullName             String
  email                String
  phone                String?
  city                 String?
  country              String?  @default("India")
  investorType         String
  organization         String?
  websiteLinkedin      String?
  investmentExperience String?
  investmentRange      String?
  investmentTimeline   String?
  interestMessage      String?
  contributionMessage  String?
  consent              Boolean  @default(true)
  status               String   @default("NEW") // NEW, CONTACTED, IN_DISCUSSION, QUALIFIED, CLOSED, NOT_SUITABLE
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id                String                         @id // matches Supabase auth.users id (UUID)
  email             String                         @unique
  fullName          String?
  role              String                         @default("ORG_ADMIN") // ORG_ADMIN, TECHNICIAN, CLIENT, SUPER_ADMIN
  status            String                         @default("ACTIVE") // ACTIVE, INACTIVE
  lastLoginAt       DateTime?
  phone             String?
  employeeId        String?                        @unique
  passwordHash      String?
  assignedRegion    String?
  avatarUrl         String?
  preferredLanguage String?                        @default("en")
  welcomeSeenAt     DateTime?
  organizationId    String?
  organization      Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  inspections       Inspection[]
  workOrders        WorkOrder[]
  assignedJobs      Job[]                          @relation("TechnicianJobs")
  assignedBuildings TechnicianBuildingAssignment[]
  syncQueueItems    SyncQueue[]
  deviceTokens      DeviceToken[]
  deletionRequests  AccountDeletionRequest[]
  credentials       TechnicianCredential[]
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@index([organizationId])
  @@index([organizationId, role, status])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model Organization {
  id                        String                   @id @default(cuid())
  name                      String
  contactPerson             String?
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  state                     String?
  gstin                     String?
  licenseNumber             String?
  autoSchedulingEnabled     Boolean                  @default(true)
  brandLogoUrl              String?
  signatoryName             String?
  signatoryDesignation      String?
  signatorySignatureUrl     String?
  reportFooterText          String?
  clientPortalEnabled       Boolean                  @default(true)
  publicVerificationEnabled Boolean                  @default(true)
  plan                      String                   @default("FOUNDING_MONTHLY") // TRIAL, FOUNDING_MONTHLY, FOUNDING_ANNUAL, BIG_AGENCY, CUSTOM
  monthlyPrice              Int                      @default(3999)
  subscriptionStatus        String                   @default("ACTIVE") // TRIAL, ACTIVE, EXPIRED
  subscriptionExpiresAt     DateTime?
  subscriptionNotes         String?
  subscription              Subscription?
  users                  UserProfile[]
  clients                Client[]
  buildings              Building[]
  equipments             Equipment[]
  jobs                   Job[]
  inspections            Inspection[]
  defects                Defect[]
  correctiveActions      CorrectiveAction[]
  cycleRules             CycleRule[]
  floorPlans             FloorPlan[]
  workOrders             WorkOrder[]
  reports                ComplianceReport[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  deletionRequests       AccountDeletionRequest[]
  portalUsers            PortalUser[]
  agencyCredentials      AgencyCredential[]
  technicianCredentials  TechnicianCredential[]
  jurisdictionTemplates  JurisdictionTemplate[]
  legalReferences        LegalReference[]
  inspectionReports      InspectionReport[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([createdAt])
  @@index([subscriptionStatus])
  @@index([subscriptionExpiresAt])
}

model Company {
  id             String    @id @default(cuid())
  name           String    @default("Vigil Fire & Safety Solutions")
  licenseNumber  String    @default("")
  phone          String    @default("+91 98201 54321")
  email          String    @default("compliance@vigilfire.in")
  address        String    @default("Plot 24, Okhla Industrial Area Phase III, New Delhi, Delhi NCR")
  clients        Client[]
  createdAt      DateTime  @default(now())
}

model Client {
  id             String        @id @default(cuid())
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String
  phone          String
  email          String?
  buildings      Building[]
  jobs           Job[]
  portalUsers    PortalUser[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model Building {
  id                    String                         @id @default(cuid())
  clientId              String?
  client                Client?                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  address               String
  city                  String?
  state                 String?
  complianceCycle       String                         @default("Half-Yearly")
  reportingCycle        String?                        @default("Half-Yearly") // Monthly, Quarterly, Half-Yearly, Yearly
  complianceRuleName    String?
  cycleIntervalMos      Int                            @default(6)
  leadTimeDays          Int                            @default(7)
  cycleOverrides        String?
  nextFilingDueDate     DateTime?
  latitude              Float?
  longitude             Float?
  occupancyType         String?
  buildingHeight        String?
  localAuthority        String?
  jurisdictionCode      String?
  fscNumber             String?
  fscValidityDate       DateTime?
  fireNocNumber         String?
  fireNocIssueDate      DateTime?
  fireNocExpiryDate     DateTime?
  equipments            Equipment[]
  jobs                  Job[]
  inspections           Inspection[]
  defects               Defect[]
  correctiveActions     CorrectiveAction[]
  cycleRules            CycleRule[]
  floorPlans            FloorPlan[]
  workOrders            WorkOrder[]
  reports               ComplianceReport[]
  inspectionReports     InspectionReport[]
  reportAcks            ReportAck[]
  technicianAssignments TechnicianBuildingAssignment[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, createdAt])
}

model Equipment {
  id                    String            @id @default(cuid())
  buildingId            String
  building              Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCode                String            @unique
  type                  String            // Extinguisher, Hydrant, Hose Reel, Alarm Panel, Sprinkler
  category              String?           // Fire Suppression, Detection, Passive
  capacity              String            // e.g. "ABC 6kg", "CO2 4.5kg", "Single Head 63mm"
  location              String            // e.g. "Floor 3 - Wing A Lift Lobby"
  floor                 String?
  wing                  String?
  manufacturer          String?
  model                 String?
  serialNumber          String?
  installDate           DateTime          @default(now())
  lastServiceDate       DateTime
  nextDueDate           DateTime
  refillDueDate         DateTime?
  hydroDueDate          DateTime?
  serviceIntervalMonths Int               @default(12)
  status                String            @default("COMPLIANT") // COMPLIANT, DUE_SOON, OVERDUE, DEFECTIVE
  photoUrl              String?
  serviceLogs           ServiceLog[]
  inspections           Inspection[]
  defects               Defect[]
  workOrders            WorkOrder[]
  jobAssets             JobAsset[]
  inspectionPhotos      InspectionPhoto[]
  inspectionIssues      InspectionIssue[]
  inspectionParts       InspectionPart[]
  correctiveActions     CorrectiveAction[]
  floorPlanPins         FloorPlanPin[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([nextDueDate])
  @@index([status])
  @@index([organizationId, buildingId])
  @@index([organizationId, nextDueDate])
  @@index([organizationId, status])
}

model Job {
  id             String      @id @default(cuid())
  jobNumber      String      @unique // e.g. "JOB-2026-001"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  technicianId   String
  technician     UserProfile @relation("TechnicianJobs", fields: [technicianId], references: [id], onDelete: Cascade)
  title          String?
  serviceType    String      @default("Fire Extinguisher Inspection") // Fire Extinguisher Inspection, AMC Quarterly Audit, Annual Overhaul
  scheduledDate  DateTime
  priority       String      @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status         String      @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, OVERDUE, CANCELLED
  notes          String?
  completedAt    DateTime?
  jobAssets      JobAsset[]
  inspections    Inspection[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([technicianId])
  @@index([status])
}

model JobAsset {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING, INSPECTED, SKIPPED
  inspectedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([jobId, equipmentId])
  @@index([equipmentId])
  @@index([status])
}

model ServiceLog {
  id             String    @id @default(cuid())
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  technicianName String    @default("Field Technician")
  servicedAt     DateTime  @default(now())
  nextDueDate    DateTime
  actionType     String    @default("Routine Refill & Pressure Check")
  notes          String?

  @@index([equipmentId])
  @@index([nextDueDate])
  @@index([servicedAt])
}

model Inspection {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId          String
  building            Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipmentId         String?
  equipment           Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  technicianId        String?
  technician          UserProfile?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianName      String            @default("Field Technician")
  jobId               String?
  job                 Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  date                DateTime          @default(now())
  status              String            @default("PASSED") // PASSED, FAILED, SERVICE_REQUIRED, REPLACEMENT_REQUIRED
  checklist           String?           // JSON string of all checklist values
  pressureGauge       String?           @default("NORMAL") // NORMAL, LOW, HIGH, NA
  overallCondition    String?           @default("GOOD")   // GOOD, NEEDS_ATTENTION, DAMAGED
  remarks             String?
  customerName        String?
  customerDesignation String?
  customerSignature   String?           // Digital signature data URL
  technicianSignature String?           // Technician signature data URL
  photos              String?           // Legacy JSON array of URLs
  latitude            Float?
  longitude           Float?
  gpsAccuracy         Float?
  isImported          Boolean           @default(false)
  approvalStatus      String            @default("PENDING") // PENDING, APPROVED, RETURNED
  approvalNote        String?
  approvedAt          DateTime?
  approvedByUserId    String?
  inspectionPhotos    InspectionPhoto[]
  issues              InspectionIssue[]
  partsUsed           InspectionPart[]
  defects             Defect[]
  correctiveActions   CorrectiveAction[]
  createdAt           DateTime          @default(now())

  @@index([organizationId])
  @@index([buildingId])
  @@index([equipmentId])
  @@index([technicianId])
  @@index([status])
  @@index([approvalStatus])
  @@index([organizationId, approvalStatus])
  @@index([organizationId, date])
  @@index([createdAt])
  @@index([date])
}

model InspectionPhoto {
  id           String      @id @default(cuid())
  inspectionId String
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  equipmentId  String?
  equipment    Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  category     String      @default("OTHER") // FRONT, GAUGE, SEAL, SERIAL, DAMAGE, LOCATION, OTHER
  photoUrl     String      // Base64 data URL or remote URL
  caption      String?
  capturedAt   DateTime?   // device capture time (authoritative)
  dayOfWeek    String?     // "MON".."SUN" derived at capture
  latitude     Float?
  longitude    Float?
  gpsAccuracy  Float?
  gpsSource    String?     // "LIVE" | "BASEMENT_CACHED"
  createdAt    DateTime    @default(now())

  @@index([inspectionId])
  @@index([equipmentId])
}

model InspectionIssue {
  id           String      @id @default(cuid())
  inspectionId String
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  equipmentId  String?
  equipment    Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  category     String      // LOW_PRESSURE, DAMAGED_CYLINDER, CORROSION, MISSING_PIN, BROKEN_SEAL, DAMAGED_HOSE, EXPIRED_UNIT, REFILL_REQUIRED, HYDRO_TEST_REQUIRED, RELOCATION_REQUIRED, REPLACEMENT_REQUIRED, OTHER
  description  String
  severity     String      @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status       String      @default("OPEN")   // OPEN, RESOLVED
  createdAt    DateTime    @default(now())

  @@index([inspectionId])
  @@index([equipmentId])
  @@index([status])
}

model InspectionPart {
  id           String      @id @default(cuid())
  inspectionId String
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  equipmentId  String?
  equipment    Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  partName     String      // ABC Powder, Safety Pin, Discharge Hose, Pressure Gauge, Seal, etc.
  quantity     Int         @default(1)
  serialNumber String?
  remarks      String?
  createdAt    DateTime    @default(now())

  @@index([inspectionId])
  @@index([equipmentId])
}

model Defect {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipmentId    String?
  equipment      Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  inspectionId   String?
  inspection     Inspection?   @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  description    String
  severity       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String        @default("OPEN")   // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  photoUrl       String?
  reportedAt     DateTime      @default(now())
  resolvedAt     DateTime?
  workOrders     WorkOrder[]

  @@index([organizationId])
  @@index([buildingId])
  @@index([equipmentId])
  @@index([status])
}

model WorkOrder {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipmentId    String?
  equipment      Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  defectId       String?
  defect         Defect?       @relation(fields: [defectId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     UserProfile?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  title          String
  description    String
  priority       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String        @default("OPEN")   // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate         DateTime?
  completedAt     DateTime?
  notes           String?
  isAutoScheduled Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([equipmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([organizationId, status])
  @@index([createdAt])
}

model CorrectiveAction {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId       String
  building         Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipmentId      String?
  equipment        Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  inspectionId     String?
  inspection       Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  assetRef         String?
  title            String
  description      String       @default("")
  severity         String       @default("MEDIUM") // LOW, MEDIUM, HIGH
  status           String       @default("OPEN")   // OPEN, DISPATCHED, REPAIRED, VERIFIED, CLOSED
  reportedByUserId String?
  assignedToUserId String?
  workshopNote     String?
  openedAt         DateTime     @default(now())
  dispatchedAt     DateTime?
  repairedAt       DateTime?
  verifiedAt       DateTime?
  closedAt         DateTime?
  closedByUserId   String?
  closeNote        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([status])
  @@index([organizationId, status])
  @@index([openedAt])
}

model CycleRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  assetType      String       @default("ALL") // ALL, EXTINGUISHER, HYDRANT, SPRINKLER, PANEL, RISER
  cycle          String       @default("HALF_YEARLY") // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  leadTimeDays   Int          @default(7)
  autoSchedule   Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  @@unique([buildingId, assetType])
  @@index([organizationId])
  @@index([buildingId])
}

model FloorPlan {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorLabel     String
  imageUrl       String
  uploadedAt     DateTime       @default(now())
  pins           FloorPlanPin[]

  @@index([organizationId])
  @@index([buildingId])
}

model FloorPlanPin {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  buildingId  String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  xPct        Float
  yPct        Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
  @@index([equipmentId])
  @@index([buildingId])
}

model ComplianceReport {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  reportNumber   String        @unique
  cyclePeriod    String
  generatedAt    DateTime      @default(now())
  totalEquipment Int
  compliantCount Int
  dueCount       Int
  overdueCount   Int
  status         String        @default("COMPLIANT") // COMPLIANT, ACTION_NEEDED

  @@index([organizationId])
  @@index([buildingId])
  @@index([status])
  @@index([generatedAt])
}

model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  title          String
  message        String
  type           String        @default("INFO") // INFO, WARNING, ALERT, SUCCESS
  link           String?
  read           Boolean       @default(false)
  pushSent       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

model SyncQueue {
  id             String       @id @default(cuid())
  technicianId   String
  technician     UserProfile  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clientSyncId   String       @unique
  actionType     String       // COMPLETE_INSPECTION, UPDATE_STATUS, UPLOAD_PHOTO, COMPLETE_WORK_ORDER
  payload        String       // JSON data of the action
  status         String       @default("PENDING") // PENDING, SYNCED, FAILED
  errorMessage   String?
  createdAt      DateTime     @default(now())
  syncedAt       DateTime?

  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
  @@index([syncedAt])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  userEmail      String?
  action         String
  entityType     String
  entityId       String?
  details        String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@index([action])
}

model Subscription {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              String       @default("BASIC") // BASIC, PRO, ENTERPRISE
  status            String       @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELLED, EXPIRED
  billingCycle      String       @default("MONTHLY") // MONTHLY, ANNUAL
  startedAt         DateTime     @default(now())
  expiresAt         DateTime?
  renewalDate       DateTime?
  amount            Int          @default(3999)
  currency          String       @default("INR")
  customTechnicians Int?         // Override seat limit for enterprise/custom deals
  customTowers      Int?         // Override tower limit for enterprise/custom deals
  customAssets      Int?         // Override asset limit for enterprise/custom deals
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

model TechnicianBuildingAssignment {
  id           String      @id @default(cuid())
  technicianId String
  technician   UserProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  assignedAt   DateTime    @default(now())
  assignedById String?

  @@unique([technicianId, buildingId])
  @@index([technicianId])
  @@index([buildingId])
}

model Feedback {
  id              String   @id @default(cuid())
  organizationId  String?
  userId          String?
  userEmail       String?
  confusingText   String?
  missingFeatures String?
  fairPrice       String?
  rating          Int?
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model DeviceToken {
  id           String      @id @default(cuid())
  technicianId String
  technician   UserProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  fcmToken     String      @unique
  platform     String      @default("android")
  lastSeenAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([technicianId])
}

model AccountDeletionRequest {
  id             String       @id @default(cuid())
  userProfileId  String
  userProfile    UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, PROCESSED, CANCELLED
  reason         String?
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userProfileId])
  @@index([organizationId, status])
  @@index([status])
}

model PortalUser {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientOrgId         String
  client              Client        @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)
  email               String
  name                String
  invitedByUserId     String?
  magicTokenHash      String?
  magicTokenExpiresAt DateTime?
  lastLoginAt         DateTime?
  revokedAt           DateTime?
  createdAt           DateTime      @default(now())
  reportAcks          ReportAck[]

  @@unique([organizationId, email])
  @@index([email])
  @@index([clientOrgId])
  @@index([organizationId])
  @@index([createdAt])
}

model ReportAck {
  id             String      @id @default(cuid())
  reportRef      String
  buildingId     String
  building       Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  portalUserId   String
  portalUser     PortalUser  @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime    @default(now())

  @@unique([reportRef, portalUserId])
  @@index([buildingId])
  @@index([portalUserId])
  @@index([acknowledgedAt])
}

model JurisdictionTemplate {
  id                  String              @id @default(cuid())
  organizationId      String?
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String              // DELHI, UP_NOIDA, HR_GURUGRAM, GENERAL
  state               String              // NCT of Delhi, Uttar Pradesh, Haryana, All India
  city                String              // Delhi, Noida, Gurugram, General
  templateName        String              // e.g. "Delhi AMC Inspection Report"
  reportType          String              @default("FIRE_SAFETY_INSPECTION_REPORT")
  isStatutoryForm     Boolean             @default(false)
  statutoryFormCode   String?             // e.g. "DELHI_FORM_B", "DELHI_FORM_H"
  statutoryPurpose    String?
  issuingAuthority    String?
  status              String              @default("ACTIVE") // ACTIVE, DRAFT_PENDING_LEGAL_REVIEW, INACTIVE
  version             String              @default("1.0.0")
  effectiveDate       DateTime            @default(now())
  verifiedBy          String?
  verifiedAt          DateTime?
  configJson          String?             // JSON configuration for jurisdiction fields & procedures
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([code])
  @@index([organizationId])
  @@index([status])
  @@map("jurisdiction_templates")
}

model LegalReference {
  id                     String        @id @default(cuid())
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jurisdictionCode       String        @default("GENERAL") // DELHI, UP_NOIDA, HR_GURUGRAM, GENERAL
  state                  String
  city                   String
  department             String
  actName                String
  ruleNumber             String?
  notificationNumber     String?
  applicableStandard     String?
  equipmentCategory      String?       // PORTABLE_EXTINGUISHER, WHEELED_EXTINGUISHER, HYDRANT, HOSE_REEL, ALARM_PANEL, SMOKE_DETECTOR, SPRINKLER, FIRE_PUMP, EMERGENCY_LIGHTING, GENERAL
  officialSourceUrl      String
  publicationDate        DateTime?
  effectiveDate          DateTime?
  lastVerifiedDate       DateTime?
  version                String        @default("2024")
  currentStatus          String        @default("LEGAL REFERENCE PENDING VERIFICATION") // VERIFIED_ACTIVE, LEGAL REFERENCE PENDING VERIFICATION, OUTDATED, SUPERSEDED
  verificationNotes      String?
  verifiedBy             String?
  approvalStatus         String        @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([jurisdictionCode])
  @@index([organizationId])
  @@index([approvalStatus])
  @@map("legal_references")
}

model AgencyCredential {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName              String
  businessAddress        String?
  contactInfo            String?
  gstin                  String?
  licenseNumber          String?
  issuingAuthority       String?
  issueDate              DateTime?
  expiryDate             DateTime?
  supportingDocUrl       String?
  verificationStatus     String        @default("NOT_PROVIDED") // NOT_PROVIDED, PENDING_VERIFICATION, VERIFIED, REJECTED, EXPIRED
  verifiedBy             String?
  verifiedAt             DateTime?
  reviewNotes            String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([organizationId])
  @@index([verificationStatus])
  @@map("agency_credentials")
}

model TechnicianCredential {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfileId          String?
  userProfile            UserProfile?  @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  fullName               String
  employeeId             String?
  designation            String        @default("Field Service Technician")
  qualification          String?
  trainingDetails        String?
  certificationDetails   String?
  issuingOrganization    String?
  certificateNumber      String?
  validityDate           DateTime?
  supportingDocUrl       String?
  verificationStatus     String        @default("NOT_PROVIDED") // NOT_PROVIDED, PENDING_VERIFICATION, VERIFIED, REJECTED, EXPIRED
  verifiedBy             String?
  verifiedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([organizationId])
  @@index([userProfileId])
  @@index([verificationStatus])
  @@map("technician_credentials")
}

model InspectionReport {
  id                     String                  @id @default(cuid())
  organizationId         String?
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId             String
  building               Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  reportReferenceId      String                  @unique
  reportType             String                  @default("FIRE_SAFETY_INSPECTION_REPORT")
  reportTitle            String                  @default("VIGILAMC FIRE SAFETY INSPECTION & MAINTENANCE REPORT")
  reportSubtitle         String                  @default("Equipment Inspection, Maintenance Records and Field Verification Report.")
  jurisdictionCode       String                  @default("GENERAL") // DELHI, UP_NOIDA, HR_GURUGRAM, GENERAL
  templateVersion        String                  @default("1.0.0")
  reportingPeriod        String
  inspectionStatus       String                  @default("INSUFFICIENT DATA") // NOT INSPECTED, INSPECTION IN PROGRESS, INSPECTION COMPLETED, INSPECTION COMPLETED - ACTION REQUIRED, CORRECTIVE ACTION PENDING, CORRECTIVE ACTION COMPLETED, INSUFFICIENT DATA
  compliancePercentage   Float?
  totalRegistered        Int                     @default(0)
  inspectedCount         Int                     @default(0)
  operationalCount       Int                     @default(0)
  nonOperationalCount    Int                     @default(0)
  maintenanceDueCount    Int                     @default(0)
  overdueCount           Int                     @default(0)
  notInspectedCount      Int                     @default(0)
  openDefectsCount       Int                     @default(0)
  resolvedDefectsCount   Int                     @default(0)
  integrityHash          String
  generatedAt            DateTime                @default(now())
  versions               ReportVersion[]
  assets                 ReportAsset[]
  evidences              InspectionEvidence[]
  signatures             ReportSignature[]
  verificationLogs       ReportVerificationLog[]

  @@index([organizationId])
  @@index([buildingId])
  @@index([reportReferenceId])
  @@index([inspectionStatus])
  @@index([generatedAt])
  @@map("inspection_reports")
}

model ReportVersion {
  id                 String           @id @default(cuid())
  inspectionReportId String
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
  versionNumber      Int              @default(1)
  templateVersion    String           @default("1.0.0")
  snapshotJson       String           // Immutable JSON snapshot so historical reports retain original template & data
  integrityHash      String
  createdByUserId    String?
  createdAt          DateTime         @default(now())

  @@index([inspectionReportId])
  @@map("report_versions")
}

model ReportAsset {
  id                 String           @id @default(cuid())
  inspectionReportId String
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
  equipmentId        String?
  assetTag           String
  type               String
  make               String?
  model              String?
  capacity           String?
  serialNumber       String?
  floor              String?
  location           String
  lastServiceDate    DateTime?
  nextDueDate        DateTime?
  inspectionStatus   String           // OPERATIONAL, NON_OPERATIONAL, MAINTENANCE_DUE, OVERDUE, NOT_INSPECTED
  applicableStandard String?
  createdAt          DateTime         @default(now())

  @@index([inspectionReportId])
  @@map("report_assets")
}

model InspectionEvidence {
  id                 String           @id @default(cuid())
  inspectionReportId String
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
  inspectionId       String?
  equipmentRef       String?
  photoUrl           String?
  capturedAt         DateTime?
  latitude           Float?
  longitude          Float?
  gpsVerified        Boolean          @default(false)
  technicianName     String
  checklistJson      String?
  observations       String?
  createdAt          DateTime         @default(now())

  @@index([inspectionReportId])
  @@map("inspection_evidence")
}

model ReportSignature {
  id                  String           @id @default(cuid())
  inspectionReportId  String
  inspectionReport    InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
  role                String           // TECHNICIAN, AGENCY_REPRESENTATIVE, CLIENT_ACKNOWLEDGEMENT
  signerName          String
  signerDesignation   String?
  signatureDataUrl    String?
  signedAt            DateTime         @default(now())

  @@index([inspectionReportId])
  @@map("report_signatures")
}

model ReportVerificationLog {
  id                 String            @id @default(cuid())
  inspectionReportId String?
  inspectionReport   InspectionReport? @relation(fields: [inspectionReportId], references: [id], onDelete: SetNull)
  queriedRef         String
  verificationResult String            // VERIFIED_AUTHENTIC, ASSET_VERIFIED, NOT_FOUND
  ipHash             String?
  userAgent          String?
  verifiedAt         DateTime          @default(now())

  @@index([inspectionReportId])
  @@index([queriedRef])
  @@map("report_verification_logs")
}

model OwnerCredential {
  id           String    @id @default("singleton")
  loginId      String    @default("shaizan@vigilamc.com")
  passwordHash String
  updatedBy    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("owner_credentials")
}

